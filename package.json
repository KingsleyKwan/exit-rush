{
  "name": "exit-rush",
  "version": "0.8.1",
  "description": "逼落車 — Exit Rush on 香城鐵路 / Hong City Rail: push through crowds to exit the train",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:sim": "esbuild scripts/simTest.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.cache/simTest.mjs && node .cache/simTest.mjs",
    "build:native": "tsc && VITE_PLATFORM=ios vite build --base /",
    "cap:sync": "npm run build:native && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run cap:sync && cap run ios",
    "assets:ios": "capacitor-assets generate --ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
