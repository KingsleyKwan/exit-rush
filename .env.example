# Public RevenueCat iOS SDK key. Not a secret in the same way as a .p8, but do not commit a real value.
# Copy to .env.local (gitignored) for store builds. Leave empty to keep purchases unavailable.
VITE_REVENUECAT_IOS_KEY=

# AdMob interstitial unit id (iOS). Leave empty to use Google's public demo unit for TestFlight.
# Real production unit: create in AdMob console, then set here (and put the real App ID in Info.plist GADApplicationIdentifier).
# Demo interstitial: ca-app-pub-3940256099942544/4411468910
# Demo App ID (Info.plist): ca-app-pub-3940256099942544~1458002511
VITE_ADMOB_INTERSTITIAL_ID=
